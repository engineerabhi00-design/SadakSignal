# Local development defaults
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
DATABASE_URL=sqlite:///./potholes.db

# Optional cloud object storage; local storage is used when disabled
USE_AWS_S3=false
AWS_S3_FALLBACK_TO_LOCAL=true
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
AWS_S3_UPLOAD_PREFIX=potholes
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional SMTP notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_SENDER_EMAIL=

# Install a pothole-trained YOLO checkpoint at Backend/weights before using this path.
MODEL_PATH=./weights/pothole_yolov8n.pt
CONFIDENCE_THRESHOLD=0.15
IOU_THRESHOLD=0.45
